      "updated": 1780087094932,
      "link": null,
      "locked": false,
      "text": "# Stage 1: Build / Compile\nFROM ubuntu as build\nRUN apt-get update && apt-get install -y curl\nRUN curl -sL https://deb.nodesource.com/setup_18.x | bash -\nRUN apt-get install -y nodejs && npm install -g typescript\n\nWORKDIR /app\nCOPY package*.json ./\nRUN npm install\nCOPY . .\nRUN tsc\n\n# Stage 2: Run / Production\nFROM node as runner\nWORKDIR /app\nCOPY package*.json ./\nRUN npm install --omit=dev\nCOPY --from=build /app/dist ./dist\n\nENTRYPOINT [\"node\", \"dist/main.js\"]\n",
      "fontSize": 20.666666666666657,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Stage 1: Build / Compile\nFROM ubuntu as build\nRUN apt-get update && apt-get install -y curl\nRUN curl -sL https://deb.nodesource.com/setup_18.x | bash -\nRUN apt-get install -y nodejs && npm install -g typescript\n\nWORKDIR /app\nCOPY package*.json ./\nRUN npm install\nCOPY . .\nRUN tsc\n\n# Stage 2: Run / Production\nFROM node as runner\nWORKDIR /app\nCOPY package*.json ./\nRUN npm install --omit=dev\nCOPY --from=build /app/dist ./dist\n\nENTRYPOINT [\"node\", \"dist/main.js\"]\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
