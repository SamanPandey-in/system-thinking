      "isDeleted": false,
      "boundElements": [],
      "updated": 1780085360818,
      "link": null,
      "locked": false,
      "text": "Removes the network isolation between the container and the host\n**Container uses the host's networking namespace directly**\nOffers maximum performance by eliminating network translation layers\nPrevents running multiple containers on the same port simultaneously\nIt is playing directly on the stadium's main floor without any boundary fences",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Removes the network isolation between the container and the host\n**Container uses the host's networking namespace directly**\nOffers maximum performance by eliminating network translation layers\nPrevents running multiple containers on the same port simultaneously\nIt is playing directly on the stadium's main floor without any boundary fences",
      "autoResize": true,
      "lineHeight": 1.25
    },
