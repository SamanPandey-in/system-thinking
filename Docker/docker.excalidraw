      "isDeleted": false,
      "boundElements": [],
      "updated": 1780082486414,
      "link": null,
      "locked": false,
      "text": "The living, breathing instance of image\nWrite-read instance of the appl\nwhen `docker run`, it pulls the image and executes it\nIf container destroyed, that top layer vanishes completely. \nUnderlying image remains untouched\nIt is the playground where all the games are played",
      "fontSize": 20.666666666666657,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The living, breathing instance of image\nWrite-read instance of the appl\nwhen `docker run`, it pulls the image and executes it\nIf container destroyed, that top layer vanishes completely. \nUnderlying image remains untouched\nIt is the playground where all the games are played",
      "autoResize": true,
      "lineHeight": 1.25
    },
