    {
      "id": "IHJDm6U0poYg8Rq3fk0VA",
      "type": "text",
      "x": 315.56812964336154,
      "y": 1526.613368052256,
      "width": 631.7000122070312,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "y9ydRaDRYC81V66LrDusI"
      ],
      "frameId": null,
      "index": "b088",
