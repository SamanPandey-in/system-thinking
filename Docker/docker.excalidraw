      "seed": 1996840356,
      "version": 1149,
      "versionNonce": 1669345180,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780085364217,
      "link": null,
      "locked": false,
      "text": "Completely disconnects the container's network interface\nProvides no external network access and no loopback address\nUsed for highly secure or completely isolated batch processing jobs\nEliminates the risk of external network attacks or data leaks\nIt is a single-player game locked inside a completely soundproof room",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Completely disconnects the container's network interface\nProvides no external network access and no loopback address\nUsed for highly secure or completely isolated batch processing jobs\nEliminates the risk of external network attacks or data leaks\nIt is a single-player game locked inside a completely soundproof room",
      "autoResize": true,
      "lineHeight": 1.25
    },
