    {
      "id": "s3T3QF7PA9CA2SfKx5J01",
      "type": "text",
      "x": 312.84285875143496,
      "y": 1257.9557411528197,
      "width": 694.933349609375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
