      "boundElements": [],
      "updated": 1780085356965,
      "link": null,
      "locked": false,
      "text": "Creates a private virtual network on the host machine\nContainers receive their own isolated internal IP addresses\nAllows containers on the same bridge to communicate with each other\n****Requires explicit port forwarding (-p) to accept outside traffic****\nIt is a closed private playground that needs a specific gate opened for spectators",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Creates a private virtual network on the host machine\nContainers receive their own isolated internal IP addresses\nAllows containers on the same bridge to communicate with each other\n****Requires explicit port forwarding (-p) to accept outside traffic****\nIt is a closed private playground that needs a specific gate opened for spectators",
      "autoResize": true,
      "lineHeight": 1.25
    },
