      "updated": 1780086385667,
      "link": null,
      "locked": false,
      "text": "FROM ubuntu\n\nRUN apt-get update\nRUN apt-get install -y curl\nRUN curl -sL https://deb.nodesource.com/setup_18.x | bash -\nRUN apt-get update -y\nRUN apt-get install -y nodejs\n\nWORKDIR /app\n\nCOPY package.json package.json\nCOPY package-lock.json package-lock.json\nRUN npm install\nCOPY main.js main.js\n\nENTRYPOINT [\"node\", \"main.js\"]",
      "fontSize": 20.666666666666657,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FROM ubuntu\n\nRUN apt-get update\nRUN apt-get install -y curl\nRUN curl -sL https://deb.nodesource.com/setup_18.x | bash -\nRUN apt-get update -y\nRUN apt-get install -y nodejs\n\nWORKDIR /app\n\nCOPY package.json package.json\nCOPY package-lock.json package-lock.json\nRUN npm install\nCOPY main.js main.js\n\nENTRYPOINT [\"node\", \"main.js\"]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "P3lLMVQUENL2DRSq5ZtYF",
      "type": "text",
      "x": 247.0979654930777,
